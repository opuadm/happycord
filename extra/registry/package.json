{
    "name": "meowcord-registry",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "migrate:local": "wrangler d1 migrations apply DB --local",
        "migrate:remote": "wrangler d1 migrations apply DB --remote",
        "test": "bun test --timeout 120000 test",
        "lint": "biome check src test scripts",
        "format": "biome format --write src test scripts"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "wrangler": "4.79.0"
    }
}
