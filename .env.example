DOMAIN=chat.example.com
INSTANCE_NAME=Happycord
POSTGRES_PASSWORD=change-me
POSTGRES_USER=meowcord
POSTGRES_DB=meowcord
MEOWCORD_VOLUME_PREFIX=meowcord
WRTC_PUBLIC_IP=203.0.113.10
WRTC_PORT=50000

# the TURN relay that carries your users' calls in servers on other instances, so those instances never see their addresses; openssl rand -hex 32. empty turns it off and those calls are refused
TURN_SECRET=
TURN_PUBLIC_IP=
TURN_PORT=3478
TURN_RELAY_PORT_MIN=49160
TURN_RELAY_PORT_MAX=49200

# the bundled caddy service; leave empty to use your own reverse proxy on 127.0.0.1:SERVER_PORT instead
COMPOSE_PROFILES=caddy
CADDY_GLOBAL_OPTIONS=
SERVER_PORT=3001
TRUSTED_PROXIES=

CAP_INSTANCE_URL=
CAP_SITE_KEY=
CAP_SECRET_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_STARTTLS=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

CLIENT_CONCURRENCY=8
LOG_REQUESTS=500,501
REVISION=
REVISION_TIME=0

E2EE_RECOVERY_KEY_FILE=
E2EE_RECOVERY_MASTER_KEY=

# outbound fetches of user-chosen URLs (embeds, media proxy, webhook avatars) go through this socks5 proxy so the server's address stays hidden; compose runs a cloudflare warp container for it. "direct" turns this off.
PUBLIC_FETCH_PROXY=
WARP_LICENSE_KEY=
